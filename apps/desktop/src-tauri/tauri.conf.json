{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lipit Capture",
  "version": "1.0.0-beta.4",
  "identifier": "com.lipit.capture",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lipit Capture",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 580,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "Muhammed Duha Polat",
    "copyright": "Copyright © 2026 Muhammed Duha Polat",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "category": "Video",
    "shortDescription": "DRM korumasız medyaları yerel olarak indirme ve klip oluşturma aracı",
    "resources": {
      "resources/": "",
      "../../../LICENSE": "licenses/LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../../licenses/": "licenses/"
    },
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg", "binaries/ffprobe", "binaries/deno"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
