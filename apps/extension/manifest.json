{
  "manifest_version": 3,
  "name": "Lipit Capture",
  "version": "1.0.0",
  "version_name": "1.0 beta 1",
  "description": "Sayfa ve ağ trafiğindeki DRM korumasız medya kaynaklarını Lipit'e gönderir.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lipit Capture"
  }
}
